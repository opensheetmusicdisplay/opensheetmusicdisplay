<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <!--
    Regression sample for slurs ending at a note with an accidental, which the curve ran into: calculateTopPoints() and
    calculateBottomPoints() stop at the left border of the end staff entry, left of the accidentals (sschmidTU's review of
    PR 1832). The slurs now end further out, past the accidentals, at most half as far from them as from the note, and keep
    clear of them from there.
    Measure 1: G4 D5 D#6, stems down, slurred (after Haydn, Concertante, m. 161): rising steeply, the slur ran into the sharp.
    The same group to E6, without an accidental, for comparison.
    Measure 2: A5 slurred to Bb5, 32nds (Telemann, Sonata No. 1, Dolce, m. 13): the short slur ran into the flat.
    Measure 3: B5 C6 D6 Eb6, slurred (Actor Prelude, m. 16): the slur ran into the flat. The same group to E6 with a natural.
    Measure 4: E5 slurred to C#5, half notes (after Schubert, An die Musik, m. 16): coming down, the slur ran into the sharp.
    Measure 5: C5 slurred to F#4, eighths with stems up, the slur below: coming down, it ran into the bottom of the sharp.
    Measure 6: D5 slurred to F#5 with a cautionary sharp in parentheses.
  -->
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
