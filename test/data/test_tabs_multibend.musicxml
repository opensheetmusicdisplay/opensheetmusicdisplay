      <!-- bend-alter is the interval of each bend in semitones, negative for a release.
           Each bend is labeled with the total bend from the unbent note, a release with what remains (none when back). -->
      <!-- a half step, then another half step: 1/2, Full -->
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>half</type>
        <stem>none</stem>
        <notations>
          <technical>
            <string>3</string>
            <fret>7</fret>
            <bend>
              <bend-alter>1</bend-alter>
            </bend>
            <bend>
              <bend-alter>1</bend-alter>
            </bend>
          </technical>
        </notations>
      </note>
      <!-- bend, release, bend: Full, (released), Full -->
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>half</type>
        <stem>none</stem>
        <notations>
          <technical>
            <string>3</string>
            <fret>7</fret>
            <bend>
              <bend-alter>2</bend-alter>
            </bend>
            <bend>
              <bend-alter>-2</bend-alter>
              <release/>
            </bend>
            <bend>
              <bend-alter>2</bend-alter>
            </bend>
          </technical>
        </notations>
      </note>
    </measure>
    <measure number="2">
      <!-- a whole step, released by a half step: Full, 1/2 -->
      <note>
        <pitch>
          <step>G</step>
          <octave>4</octave>
        </pitch>
        <duration>2</duration>
        <voice>1</voice>
