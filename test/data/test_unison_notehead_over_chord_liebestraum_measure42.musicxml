  <part id="P1">
    <!--
      Reproduces Liebestraum no. 3, bar 42, left hand: a run of quavers starting on E3,
      over a dotted minim chord E2-E3 in another voice. MuseScore writes the first quaver
      as an invisible (print-object="no") note so that the minim's head serves both
      voices. Vexflow leaves the two heads in one column, so the quaver's head must
      stay transparent: inked, it would fill the minim's open head.
    -->
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key>
          <fifths>4</fifths>
          <mode>major</mode>
        </key>
        <time>
