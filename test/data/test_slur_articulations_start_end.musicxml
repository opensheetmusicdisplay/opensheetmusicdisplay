      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>down</stem><beam number="1">begin</beam><notations><slur type="start" number="1"/><articulations><accent/></articulations></notations></note>
