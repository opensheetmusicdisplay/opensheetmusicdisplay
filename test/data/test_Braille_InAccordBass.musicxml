<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
  "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Test score for braille M4: Two-voice in-accord in bass clef.
  C major, 4/4, bass clef.
  Measure 1:
    Voice 1: G3 half, A3 half (upper voice)
    Voice 2: C3 whole (lower voice)
  Tests bass clef voice ordering: lowest voice first.
-->
<score-partwise version="3.1">
  <work><work-title>test_Braille_InAccordBass</work-title></work>
  <part-list>
    <score-part id="P1">
      <part-name>Bass</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>F</sign>
          <line>4</line>
        </clef>
      </attributes>
      <!-- Voice 1: G3 half, A3 half (upper voice) -->
      <note>
        <pitch><step>G</step><octave>3</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <stem>up</stem>
      </note>
      <note>
        <pitch><step>A</step><octave>3</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <stem>up</stem>
      </note>
      <!-- Voice 2: C3 whole (lower voice) -->
      <backup>
        <duration>8</duration>
      </backup>
      <note>
        <pitch><step>C</step><octave>3</octave></pitch>
        <duration>8</duration>
        <voice>2</voice>
        <type>whole</type>
        <stem>down</stem>
      </note>
    </measure>
  </part>
</score-partwise>
