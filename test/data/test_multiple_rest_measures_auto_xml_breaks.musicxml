<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="4.0">
  <work>
    <work-title>Multiple rest measures at system and page breaks test</work-title>
  </work>
  <!-- Measures 2-7 are whole-measure rests, which OSMD combines into multiple rest measures (AutoGenerateMultipleRestMeasuresFromRestMeasures).
       Measure 4 begins a new system, measure 6 a new page. With the options newSystemFromXML and newPageFromXML, OSMD follows these breaks,
       which it can't do within a multiple rest measure, so measures 2-3, 4-5 and 6-7 become multiple rest measures.
       Before, measures 2-7 became one multiple rest measure, and the breaks were lost.
       Without these options, OSMD ignores the breaks, and measures 2-7 still become one multiple rest measure. -->
  <part-list>
    <score-part id="P1">
      <part-name>Flute</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>4</duration><type>whole</type></note>
    </measure>
    <measure number="2">
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="3">
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="4">
      <print new-system="yes"/>
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="5">
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="6">
      <print new-page="yes"/>
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="7">
      <note><rest measure="yes"/><duration>4</duration></note>
    </measure>
    <measure number="8">
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>4</duration><type>whole</type></note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
  </part>
</score-partwise>
