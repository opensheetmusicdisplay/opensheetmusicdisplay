<score-partwise version="3.0">
  <work>
    <work-title>Slurs above fingerings, next to their start and on their last note: Träumerei m.3-4</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name/>
    </score-part>
  </part-list>
  <part id="P1">
    <!--
      Reproduces Schumann's Träumerei (Kinderszenen op. 15 no. 7), bars 3-4, right hand, with a player's fingerings 3 and 4
      over the A4 and the B-flat4 of bar 3. Two slurs placed above:
      - from the G4 to the D5 of the beamed stem-up eighths of bar 3: it has to pass above the 3 of the A4, next to its start;
      - from the F4 at the end of bar 3 to the half notes of bar 4: it has to end above the 3 of its last note, the G4.
    -->
    <measure number="3">
      <attributes>
        <divisions>2</divisions>
        <key>
          <fifths>-1</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>5</octave>
        </pitch>
        <duration>1</duration>
        <voice>1</voice>
        <type>eighth</type>
        <stem>up</stem>
        <beam number="1">begin</beam>
      </note>
