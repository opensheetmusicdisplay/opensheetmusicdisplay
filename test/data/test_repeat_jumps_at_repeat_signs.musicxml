<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <work>
    <work-title>Jumps at repeat signs</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- A D.C. or D.S. at the barline of a backward repeat to the same measure: the repeat is played first, then the jump.
         Four movements (the measure numbers restart), played:
         1. 1 (Fine) 2 (D.C. and :|): 1 2 1 2, after the D.C.: 1 (the Fine goes on with the next movement)
         2. 1 2 (To Coda) 3 (D.C. al Coda and :|) Coda 4 5: 1 2 3 1 2 3, after the D.C.: 1 2, the coda: 4 5
         3. 1 Segno |: 2 3 (To Coda) 4 (D.S. al Coda and :|) Coda 5 6: 1 2 3 4 2 3 4, after the D.S.: 2 3, the coda: 5 6
         4. 1 2 (Fine) 3 (D.S. without a segno): 1 2 3 1 2 3, back like a backward repeat, the Fine isn't taken (but drawn) -->
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
      </note>
      <direction placement="above">
        <direction-type>
          <words>Fine</words>
        </direction-type>
        <sound fine="yes"/>
      </direction>
    </measure>
    <measure number="2">
      <note>
        <pitch>
          <step>D</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
      </note>
      <direction placement="above">
        <direction-type>
          <words>D.C.</words>
        </direction-type>
        <sound dacapo="yes"/>
      </direction>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
        <repeat direction="backward"/>
      </barline>
    </measure>
    <measure number="1">
      <note>
        <pitch>
          <step>E</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
      </note>
    </measure>
    <measure number="2">
