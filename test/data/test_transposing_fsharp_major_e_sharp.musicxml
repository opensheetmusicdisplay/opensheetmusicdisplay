<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="4.0">
  <work>
    <work-title>Transposing to F# major test</work-title>
  </work>
  <!-- C major with the leading tone B (chord symbol Bm7b5), then an Ab major and an Ab minor triad, whose third Cb is chromatic.
       Transposed by +6 to F# major (6 sharps), B becomes E#, as the key signature spells it: neither E# nor the tonic F# after it
       needs an accidental, and the chord symbol is E#m7b5. The default TransposeCalculator used to write F with a natural sign,
       then F# with a sharp, and Fm7b5. The chromatic Cb becomes F with a natural sign, the third of D minor. -->
  <part-list>
    <score-part id="P1">
      <part-name>Melody</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <harmony><root><root-step>C</root-step></root><kind>major</kind></harmony>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
      <harmony><root><root-step>B</root-step></root><kind>half-diminished</kind></harmony>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><type>quarter</type></note>
    </measure>
    <measure number="2">
      <harmony><root><root-step>A</root-step><root-alter>-1</root-alter></root><kind>major</kind></harmony>
      <note><pitch><step>A</step><alter>-1</alter><octave>4</octave></pitch><duration>2</duration><type>half</type><accidental>flat</accidental></note>
      <note><chord/><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><type>half</type></note>
      <note><chord/><pitch><step>E</step><alter>-1</alter><octave>5</octave></pitch><duration>2</duration><type>half</type><accidental>flat</accidental></note>
      <harmony><root><root-step>A</root-step><root-alter>-1</root-alter></root><kind>minor</kind></harmony>
      <note><pitch><step>A</step><alter>-1</alter><octave>4</octave></pitch><duration>2</duration><type>half</type></note>
      <note><chord/><pitch><step>C</step><alter>-1</alter><octave>5</octave></pitch><duration>2</duration><type>half</type><accidental>flat</accidental></note>
      <note><chord/><pitch><step>E</step><alter>-1</alter><octave>5</octave></pitch><duration>2</duration><type>half</type></note>
      <barline location="right"><bar-style>light-heavy</bar-style></barline>
    </measure>
  </part>
</score-partwise>
