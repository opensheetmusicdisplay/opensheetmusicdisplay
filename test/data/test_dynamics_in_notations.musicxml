<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="4.0">
  <movement-title>Dynamics in a note's notations</movement-title>
  <part-list>
    <score-part id="P1">
      <part-name>Cello</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- Dynamics written in a note's <notations> instead of a <direction>, as in JosephHaydn_ConcertanteCello.xml
         (Finale's note-attached expressions). They belong to the note, and have their own placement attribute. -->
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>F</sign>
          <line>4</line>
        </clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>3</octave></pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>quarter</type>
      </note>
      <note>
        <pitch><step>D</step><octave>3</octave></pitch>
        <duration>2</duration>
        <voice>1</voice>
        <type>quarter</type>
        <notations>
          <dynamics default-y="-80" placement="below"><p/></dynamics>
        </notations>
      </note>
      <note>
        <pitch><step>E</step><octave>3</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
        <notations>
          <dynamics placement="above"><f/></dynamics>
        </notations>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>C</step><octave>3</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
      </note>
      <!-- a grace note's dynamic belongs to the grace note's time (the next note's), not to the note before -->
      <note>
        <grace slash="yes"/>
        <pitch><step>F</step><octave>3</octave></pitch>
        <voice>1</voice>
        <type>eighth</type>
        <notations>
          <dynamics placement="below"><mf/></dynamics>
        </notations>
      </note>
      <note>
        <pitch><step>E</step><octave>3</octave></pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>half</type>
      </note>
    </measure>
  </part>
</score-partwise>
