<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <!--
    Regression sample for staggering three voices where the middle and the lower note collide in ways the
    middle note's stem doesn't show, so the lower note should be moved to the right.
    Measure 1: an A4 whole note (no stem) between a D5 and a G4 a second below. The heads overlapped.
    Measure 2: a C5 with its stem up, a second above a stem-down B4, under an E6 far enough above not to
    collide. The heads overlapped. Beat 1 numbers the voices top-middle-bottom, beat 3 top-bottom-middle.
    Measure 3: crossed stems a third apart, E5 up, B4 down, G4 up. The G4 stayed on the beat, its stem
    running up the E5's stem as in a chord. Same two numberings.
    Measure 4: measure 3 with the G4's stem hidden (stem none): with no stem drawn, it stays on the beat.
  -->
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>

      <!-- Voice 1 (upper): D5, D5 -->
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 2 (middle): an A4 whole note, no stem -->
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>4</duration><voice>2</voice><type>whole</type></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 3 (lower): G4, G4 -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>down</stem></note>
    </measure>
    <measure number="2">
      <!-- Voice 1 (upper): E6, E6 -->
      <note><pitch><step>E</step><octave>6</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>E</step><octave>6</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 2: C5 (stem up, middle), then B4 (stem down, lower) -->
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>down</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 3: B4 (stem down, lower), then C5 (stem up, middle) -->
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>down</stem></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>up</stem></note>
    </measure>
    <measure number="3">
      <!-- Voice 1 (upper): E5, E5 -->
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 2: B4 (stem down, middle), then G4 (stem up, lower) -->
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>up</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 3: G4 (stem up, lower), then B4 (stem down, middle) -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>down</stem></note>
    </measure>
    <measure number="4">
      <!-- Voice 1 (upper): E5, E5 -->
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type><stem>up</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 2 (middle): B4, B4 (stems down) -->
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>down</stem></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>half</type><stem>down</stem></note>
      <backup><duration>4</duration></backup>
      <!-- Voice 3 (lower): G4, G4, stems hidden -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>none</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>3</voice><type>half</type><stem>none</stem></note>
    </measure>
  </part>
</score-partwise>
