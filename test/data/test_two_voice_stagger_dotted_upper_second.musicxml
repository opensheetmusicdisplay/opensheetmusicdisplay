<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <!--
    Regression sample for staggering two voices a second apart when the upper note is dotted.
    Voice 1 is stems up, voice 2 stems down. The upper note's dot stays next to its head, so moving
    the lower note to the right put it on the dot: when only the upper note is dotted, it is the one
    moved, with its dot.
    Measure 1: a dotted A4 over a G4 (in a space, where the G4 covered the dot), then a dotted G4
    over an F4 (on a line, its dot in the space above).
    Measure 2: both notes dotted with the upper note in a space (a dotted A4 over a dotted G4), where the
    upper note moves too, the G4's dot going to the space below; then only the lower one dotted, which moves.
    Measure 3: both notes dotted with the upper note on a line (a dotted G4 over a dotted F4), where the
    moved upper note would cover the F4's dot: the lower note moves, as before.
  -->
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>2</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>

      <!-- Voice 1 (upper): dotted A4 and an A4 eighth, dotted G4 and a G4 eighth -->
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice><type>quarter</type><dot/><stem>up</stem></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice><type>quarter</type><dot/><stem>up</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem></note>

      <backup><duration>8</duration></backup>

      <!-- Voice 2 (lower): G4, G4, F4, F4 -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note>
    </measure>
    <measure number="2">
      <!-- Voice 1 (upper): dotted A4 and an A4 eighth, then A4, A4 -->
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>3</duration><voice>1</voice><type>quarter</type><dot/><stem>up</stem></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><stem>up</stem></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><stem>up</stem></note>

      <backup><duration>8</duration></backup>

      <!-- Voice 2 (lower): dotted G4 and a G4 eighth, twice -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>3</duration><voice>2</voice><type>quarter</type><dot/><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>2</voice><type>eighth</type><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>3</duration><voice>2</voice><type>quarter</type><dot/><stem>down</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>1</duration><voice>2</voice><type>eighth</type><stem>down</stem></note>
    </measure>
    <measure number="3">
      <!-- Voice 1 (upper): dotted G4 half and a G4 quarter -->
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>6</duration><voice>1</voice><type>half</type><dot/><stem>up</stem></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><stem>up</stem></note>

      <backup><duration>8</duration></backup>

      <!-- Voice 2 (lower): dotted F4 half and an F4 quarter -->
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>6</duration><voice>2</voice><type>half</type><dot/><stem>down</stem></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><voice>2</voice><type>quarter</type><stem>down</stem></note>
    </measure>
  </part>
</score-partwise>
