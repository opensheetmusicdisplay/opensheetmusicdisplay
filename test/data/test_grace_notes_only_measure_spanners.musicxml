          <glissando type="stop" line-type="solid" number="1"/>
          <ornaments>
            <wavy-line type="stop" number="1"/>
          </ornaments>
        </notations>
      </note>
      <direction placement="below">
        <direction-type>
          <pedal type="stop" line="yes"/>
        </direction-type>
        <staff>2</staff>
      </direction>
      <direction placement="below">
        <direction-type>
          <octave-shift type="stop" size="8" number="1"/>
        </direction-type>
        <staff>2</staff>
      </direction>
    </measure>
    <measure number="3">
      <print new-system="yes"/>
      <note>
        <pitch>
          <step>C</step>
          <octave>5</octave>
        </pitch>
        <duration>8</duration>
        <voice>1</voice>
        <type>half</type>
