        <staff>2</staff>
        <notations>
          <slur type="start" number="1"/>
          <glissando type="start" line-type="solid" number="1"/>
          <ornaments>
            <trill-mark/>
            <wavy-line type="start" number="1"/>
          </ornaments>
        </notations>
      </note>
      <barline location="right">
        <bar-style>none</bar-style>
      </barline>
    </measure>
    <measure number="3" implicit="yes">
      <print new-system="yes"/>
      <note>
        <grace slash="yes"/>
        <pitch>
          <step>D</step>
          <octave>5</octave>
        </pitch>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
        <beam number="1">begin</beam>
      </note>
      <note>
        <grace slash="yes"/>
        <pitch>
          <step>B</step>
          <octave>4</octave>
        </pitch>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
