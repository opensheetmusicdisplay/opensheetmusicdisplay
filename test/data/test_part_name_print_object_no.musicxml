<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Two parts, of which the first hides its part name with print-object="no" (MusicXML part-name attribute, #808).
     OSMD must render the name label of the second part ("Oboe") but not of the first ("Flute").
     Replaces ActorPreludeSample_PartName.xml, a 1.2 MB copy of ActorPreludeSample.xml that only added this
     attribute to every part and was used by nothing but the demo sample list. -->
<score-partwise version="3.1">
  <work>
    <work-title>test_part_name_print_object_no</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name print-object="no">Flute</part-name>
      <part-abbreviation>Fl.</part-abbreviation>
    </score-part>
    <score-part id="P2">
      <part-name>Oboe</part-name>
      <part-abbreviation>Ob.</part-abbreviation>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <pitch><step>G</step><octave>5</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>A</step><octave>5</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
  </part>
  <part id="P2">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>5</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
    <measure number="2">
      <note>
        <pitch><step>D</step><octave>5</octave></pitch>
        <duration>4</duration>
        <type>whole</type>
      </note>
    </measure>
  </part>
</score-partwise>
