<!--
  Test score for braille M3: Chords with accidentals.
  C major, 4/4 time, treble clef.
  Measure 1:
    Beat 1: C4-Eb4-G4 quarter chord (flat on Eb)
    Beat 2: C4-E4-G#4 quarter chord (sharp on G#)
    Beat 3: C4-E4 quarter dyad (two-note chord)
    Beat 4: quarter rest
-->
<score-partwise version="3.1">
  <work><work-title>test_Braille_ChordsAccidentals</work-title></work>
  <part-list>
    <score-part id="P1">
      <part-name>Treble</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
