    <!-- The second half of measure 1, split off so that a system can break inside it (e.g. a long cadenza):
         grace notes only in the treble staff, with no main note in this measure, and nothing in the bass staff,
         which the pedal line from measure 1 to measure 2 has to be held through. -->
    <measure number="1" implicit="yes">
      <print new-system="yes"/>
      <note>
        <grace slash="yes"/>
        <pitch>
          <step>D</step>
          <octave>5</octave>
        </pitch>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
        <beam number="1">begin</beam>
      </note>
      <note>
        <grace slash="yes"/>
        <pitch>
          <step>B</step>
          <octave>4</octave>
        </pitch>
        <voice>1</voice>
        <type>eighth</type>
        <staff>1</staff>
        <beam number="1">end</beam>
      </note>
    </measure>
    <measure number="2">
