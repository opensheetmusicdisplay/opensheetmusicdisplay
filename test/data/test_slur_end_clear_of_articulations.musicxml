<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  A slur ending at a note with an articulation on the slur's side ends past a staccato or tenuto, by the distance it keeps
  from a note head, and under an accent or a fermata, which goes outside the slur (see test_slur_articulations_outside). It
  moved out by a fixed SlurEndArticulationYOffset, which didn't clear an accent, nor a staccato that VexFlow moves from a
  line into the next space.
  Measure 1: one voice, a slur ending at a staccato moved from the D5's line into the space above (on develop, the slur ended in it).
  Measure 2: two voices, a slur ending at a staccato at the stem end of a stem-up C5.
  Measure 3: one voice, stems down, slurs above, ending at a staccato, then at an accent, which goes above the slur's end (on
  develop, the slur ended in it).
  Measure 4: one voice, stems up, slurs below, ending at a staccato, then at a tenuto (already clear on develop).
  Measure 5: two voices, the upper voice's slurs above, ending at a staccato, then at an accent, which goes above the slur's end
  (on develop, through it).
  Measure 6: two voices, the lower voice's slurs below, ending at a staccato, then at an accent, which goes below the slur's end
  (on develop, through it).
  Measure 7: a slur ending at a fermata just above the staff, which goes above the slur's end (on develop, the slur ended in it).
  Measure 8: a slur ending under a fermata well above the staff, which stays outside the slur, as on develop.
  Measures 9-10: a slur coming down to a chord under a fermata above the staff, which stays outside the slur, as on develop:
  the slur passes under it.
  (Sample from isc's PR #1827.)
-->
<score-partwise version="4.0">
  <work><work-title>Slur ends clear of articulations</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1">
      <attributes><divisions>2</divisions><key><fifths>0</fifths></key><time><beats>4</beats><beat-type>4</beat-type></time><clef><sign>G</sign><line>2</line></clef></attributes>
      <!-- one voice: a slur from B4 to D5, stems down, the staccato of the D5 (on a line) moved into the space above -->
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>down</stem><beam number="1">begin</beam><notations><slur type="start" number="1"/></notations></note>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>down</stem><beam number="1">end</beam><notations><slur type="stop" number="1"/><articulations><staccato/></articulations></notations></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><stem>down</stem></note>
      <note><rest/><duration>4</duration><voice>1</voice><type>half</type></note>
    </measure>
    <measure number="2">
      <!-- two voices: a slur from A4 to C5, stems up, the staccato at the C5's stem end; an E4 half note below -->
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem><beam number="1">begin</beam><notations><slur type="start" number="1"/></notations></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>up</stem><beam number="1">end</beam><notations><slur type="stop" number="1"/><articulations><staccato/></articulations></notations></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><stem>up</stem></note>
      <note><rest/><duration>4</duration><voice>1</voice><type>half</type></note>
      <backup><duration>8</duration></backup>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>4</duration><voice>2</voice><type>half</type><stem>down</stem></note>
      <note><rest/><duration>4</duration><voice>2</voice><type>half</type></note>
    </measure>
    <measure number="3">
      <!-- one voice, stems down, slurs above: a staccato on the last note, then an accent -->
      <note><pitch><step>E</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><stem>down</stem><beam number="1">begin</beam><notations><slur type="start" number="1"/></notations></note>
