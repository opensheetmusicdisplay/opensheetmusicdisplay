  <part id="P1">
    <!-- Five movements (the measure numbers restart), played:
         1. |: 1 :| 2 [1. 3 :| 4 (a first ending without a forward repeat after a repeat): 1 1 2 3 2 4
         2. Segno |: 1 [1. 2 :| [2. 3 ] 4 (To Coda) 5 (D.S. al Coda) Coda 6
            (the segno in the measure of the forward repeat): 1 2 1 3 4 5, after the D.S.: 1 3 4, the coda: 6
         3. 1 2 (no repeat or jump)
         4. 1 2 (Fine) 3 ("Menuetto D.C. al Fine", back to the start of this movement): 1 2 3, after the D.C.: 1 2
         5. Segno 1 2 Segno 3 (both segnos marked as D.S. targets, <sound segno>, no D.S.): 1 2 3 -->
    <measure number="1">
      <barline location="left">
        <bar-style>heavy-light</bar-style>
        <repeat direction="forward"/>
      </barline>
      <attributes>
        <divisions>1</divisions>
        <key>
          <fifths>0</fifths>
        </key>
        <time>
          <beats>4</beats>
          <beat-type>4</beat-type>
        </time>
        <clef>
          <sign>G</sign>
          <line>2</line>
        </clef>
      </attributes>
      <note>
        <pitch>
          <step>C</step>
          <octave>4</octave>
        </pitch>
        <duration>4</duration>
        <voice>1</voice>
        <type>whole</type>
      </note>
