<score-partwise version="3.0">
  <work>
    <work-title>Slur under a fingering on the stem of another voice: Träumerei m.11</work-title>
  </work>
  <part-list>
    <score-part id="P1">
      <part-name/>
    </score-part>
  </part-list>
  <part id="P1">
    <!--
      Reproduces Schumann's Träumerei (Kinderszenen op. 15 no. 7), bar 11, right hand, with the fingerings of the edition.
      The lower voice's slur from the E-flat4 to the G4, placed above, passes under the stem of the upper voice's B-flat4
      and the 5 on top of it: no slur within SlurTangentMaxAngle gets over that 5, so the slur stays under it.
    -->
