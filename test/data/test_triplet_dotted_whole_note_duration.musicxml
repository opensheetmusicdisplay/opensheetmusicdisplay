  <work>
    <work-title>test_triplet_dotted_whole_note_duration</work-title>
  </work>
  <identification>
    <encoding>
      <software>hand-written for OpenSheetMusicDisplay</software>
      <encoding-date>2026-09-26</encoding-date>
    </encoding>
    <miscellaneous>
      <miscellaneous-field name="comment">A whole-note triplet (3 in the time of 2) with a dotted whole note, a half note and a whole note
        in 4/2, like a coloration in a transcription of Renaissance music. Sounding lengths: 1, 1/3 and 2/3 of a whole note.
        m.1 is encoded correctly: each note's duration already reflects the tuplet (12, 4 and 8 at 3 divisions).
        m.2 is encoded un-reduced like the musx2mxl export bug: the durations of the written types (18, 6 and 12).
        Both measures should be read identically and last a breve; m.3 is a breve.</miscellaneous-field>
    </miscellaneous>
  </identification>
